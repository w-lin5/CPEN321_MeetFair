%% Use Case 5: Share Live Location (Requirements_and_Design.md section 4.6).
sequenceDiagram
    actor M as Member
    actor O as Other members
    actor G as Meetup organizer
    participant FE as Front-end
    participant LL as Live Location
    participant UG as Users & Groups
    participant VF as Voting & Fairness
    participant MAPS as Google Maps Platform
    participant RT as Realtime Gateway
    participant DB as MongoDB

    M->>FE: tap "I am leaving", confirm "Share and start trip"
    FE-->>M: request location permission (first time)
    alt permission denied
        FE-->>M: explain that no trip was started
    else permission granted
        FE->>LL: POST /api/meetups/:meetupId/trip/start
        LL->>UG: getForMember(meetupId, userId)
        LL->>DB: create trip (server-set startedAt)
        LL->>RT: publish(meetup room, trip:updated)
        LL-->>FE: 200 Trip
        loop while sharing is active
            FE->>LL: PUT /api/meetups/:meetupId/trip/location {lat, lng, accuracyM}
            LL->>UG: getForMember(meetupId, userId)
            LL->>DB: save latest location
            LL->>RT: publish(meetup room, trip:updated)
            RT-->>O: trip:updated {meetupId}
            O->>LL: GET /api/meetups/:meetupId/trips
            LL->>UG: requireMembership(groupId, userId)
            LL-->>O: trips with latest locations
        end
        M->>FE: tap "I arrived", confirm
        FE->>LL: POST /api/meetups/:meetupId/trip/arrive
        LL->>DB: set arrivedAt and actualSeconds, clear location
        LL->>RT: publish(meetup room, trip:updated)
        LL-->>FE: 200 Trip (commute duration)
        FE-->>M: stop sharing, show actual commute
    end
    G->>FE: tap "Settle Fair Credit", confirm "Settle"
    FE->>LL: POST /api/meetups/:meetupId/settle
    LL->>UG: getForMember(meetupId, userId)
    alt not the organizer, not finalized, too early, or a trip is still active
        LL-->>FE: 403 or 409 with the reason
        FE-->>G: show error
    else meetup already SETTLED
        LL-->>FE: 200 Meetup, no duplicate Fair Credit change
    else can settle
        LL->>DB: read trips and stored travel estimates
        opt a member has neither a tracked trip nor a stored estimate
            LL->>MAPS: Routes computeRouteMatrix(origins, destination)
            MAPS-->>LL: travel times
        end
        LL->>DB: save settlement snapshot
        LL->>VF: settleMeetup(groupId, meetupId, trips)
        VF->>DB: write ledger entries and balances
        LL->>DB: set status to SETTLED
        LL->>RT: publish(meetup room, meetup:status SETTLED)
        LL-->>FE: 200 Meetup
        FE-->>G: show settled meetup
    end
